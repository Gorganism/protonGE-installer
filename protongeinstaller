#!/bin/python

import os
HOME = os.getenv("HOME")

version = input("ProtonGE version to install (e.g. \"9-27\"): ")

# versions after 11-4 require -x86_64
if not (("x86_64" in version) or ("aarch64" in version)):
    print("Mind that the naming convention for ProtonGE has changed after 11-3, and the version must include the architecture (e.g. 11-4-x86_64)")

flatpak = input("Install for native or flatpak?\n   1) Native  2) Flatpak\nEnter a number(default=1): ")

if flatpak == "1" or flatpak == "":
    wd = f"{HOME}/.steam/steam/compatibilitytools.d/"
elif flatpak == "2":
    wd = f"{HOME}/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d/"
#wd = f"{HOME}/testdir/"

os.system(f"mkdir -p {wd}")
os.chdir(wd)
if ("x86_64" in version) or ("aarch64" in version):
    vtrunc = version.replace("-x86_64","")
    vtrunc = vtrunc.replace("-aarch64","")
    os.system(f"wget https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton{vtrunc}/GE-Proton{version}.tar.gz")
else:
    os.system(f"wget https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton{version}/GE-Proton{version}.tar.gz")
os.system(f"tar xzvf GE-Proton{version}.tar.gz")
os.system(f"rm -v GE-Proton{version}.tar.gz")

print("\nPackage installation process completed.")
